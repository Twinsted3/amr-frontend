<?xml version="1.0" ?>
<robot name="forklift" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>
  <xacro:arg name="robot_id" default="agv01"/>
  <xacro:property name="robot_id" value="$(arg robot_id)"/>
  <xacro:arg name="lidar_samples" default="360"/>
  <xacro:arg name="lidar_rate" default="10"/>
  <xacro:arg name="mapping_lidar" default="false"/>
  <xacro:arg name="survey_lidar_samples" default="360"/>
  <xacro:arg name="survey_lidar_rate" default="5"/>
  <xacro:arg name="odom_rate" default="50"/>
  <xacro:arg name="enable_rgbd" default="false"/>

  <!-- 材质定义 -->
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.4235 0.0392 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>

  <!-- 基座投影 -->
  <link name="${namespace}base_footprint"/>
  <link name="${namespace}base_link"/>
  <joint name="${namespace}base_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="${namespace}base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="${namespace}body_geometry_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}body_geometry_link"/>
    <!-- Differential odometry is integrated at the drive axle center. -->
    <!-- +X of base_footprint is travel direction; forks extend toward -X. -->
    <origin xyz="-1.020 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= 主车体底盘与固定外壳 ================= -->
  <link name="${namespace}body_geometry_link">
    <!-- 1. 黑色防撞底盘 (X跨度优化至 0.80~1.10，确保前后雷达完全凸出不被遮挡) -->
    <visual>
      <origin xyz="0.95 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.30 0.930 0.1"/></geometry>
      <material name="dark"/>
    </visual>
    <!-- 【极其关键的优化】：将底盘的碰撞盒底部抬高至 0.125，完美避开高度 0.10 的连续驱动轮，防止摩擦爆炸 -->
    <collision>
      <origin xyz="0.95 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.30 0.930 0.05"/></geometry>
    </collision>

    <!-- 2. 橙色主箱体 -->
    <visual>
      <origin xyz="0.95 0 1.04" rpy="0 0 0"/>
      <geometry><box size="0.30 0.930 1.78"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.95 0 1.04" rpy="0 0 0"/>
      <geometry><box size="0.30 0.930 1.78"/></geometry>
    </collision>

    <!-- 3. 固定底腿 (向后延伸连接新车架边缘 0.80) -->
    <visual>
      <origin xyz="0.1775 0.25 0.06" rpy="0 0 0"/>
      <geometry><box size="1.245 0.18 0.04"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.1775 0.25 0.06" rpy="0 0 0"/>
      <geometry><box size="1.245 0.18 0.04"/></geometry>
    </collision>
    
    <visual>
      <origin xyz="0.1775 -0.25 0.06" rpy="0 0 0"/>
      <geometry><box size="1.245 0.18 0.04"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.1775 -0.25 0.06" rpy="0 0 0"/>
      <geometry><box size="1.245 0.18 0.04"/></geometry>
    </collision>

    <!-- 4. 顶部蓝色雷达支架 -->
    <visual>
      <origin xyz="1.020 0 2.02" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.18"/></geometry>
      <material name="dark"/>
    </visual>

    <!-- 物理属性 -->
    <inertial>
      <origin xyz="0.95 0 0.5" rpy="0 0 0"/>
      <mass value="950"/>
      <inertia ixx="381.96" ixy="0" ixz="0" iyy="543.8" iyz="0" izz="298.6"/>
    </inertial>
  </link>

  <!-- ================= 升降机构 ================= -->
  <!-- 货叉滑动支架 -->
  <joint name="${namespace}fork_elevator_joint" type="prismatic">
    <parent link="${namespace}body_geometry_link"/>
    <child link="${namespace}fork_carriage_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.6" effort="10000" velocity="0.170"/>
  </joint>
  
  <link name="${namespace}fork_carriage_link">
    <!-- 1. 左挡货柱 -->
    <visual><origin xyz="0.75 0.25 0.585" rpy="0 0 0"/><geometry><box size="0.05 0.2 1.0"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0.75 0.25 0.585" rpy="0 0 0"/><geometry><box size="0.05 0.2 1.0"/></geometry></collision>
    <!-- 2. 右挡货柱 -->
    <visual><origin xyz="0.75 -0.25 0.585" rpy="0 0 0"/><geometry><box size="0.05 0.2 1.0"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0.75 -0.25 0.585" rpy="0 0 0"/><geometry><box size="0.05 0.2 1.0"/></geometry></collision>
    <!-- 3. 厚实的顶背靠板 (Z高度增至 0.8，外观霸气，同时底部悬空 0.285m，完美漏出 0.1m 处的后避障雷达线) -->
    <visual><origin xyz="0.75 0 0.685" rpy="0 0 0"/><geometry><box size="0.05 0.7 0.8"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0.75 0 0.685" rpy="0 0 0"/><geometry><box size="0.05 0.7 0.8"/></geometry></collision>
    <inertial><mass value="20"/><inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/></inertial>
  </link>

  <!-- 左/右货叉 -->
  <joint name="${namespace}left_fork_joint" type="fixed"><parent link="${namespace}fork_carriage_link"/><child link="${namespace}left_fork_link"/><origin xyz="0.165 0.25 0.1175" rpy="0 0 0"/></joint>
  <link name="${namespace}left_fork_link"><visual><geometry><box size="1.22 0.18 0.065"/></geometry><material name="dark"/></visual><collision><geometry><box size="1.22 0.18 0.065"/></geometry></collision><inertial><mass value="5"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial></link>

  <joint name="${namespace}right_fork_joint" type="fixed"><parent link="${namespace}fork_carriage_link"/><child link="${namespace}right_fork_link"/><origin xyz="0.165 -0.25 0.1175" rpy="0 0 0"/></joint>
  <link name="${namespace}right_fork_link"><visual><geometry><box size="1.22 0.18 0.065"/></geometry><material name="dark"/></visual><collision><geometry><box size="1.22 0.18 0.065"/></geometry></collision><inertial><mass value="5"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial></link>

  <!-- ================= 轮系结构 ================= -->
  <!-- 1. 中央大驱动轮 【关键修改：移除 Collision，仅做视觉装饰，防止力学过约束】 -->
  <joint name="${namespace}center_drive_wheel_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}center_drive_wheel_link"/><origin xyz="1.020 0 0.115" rpy="0 0 0"/></joint>
  <link name="${namespace}center_drive_wheel_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.115"/></geometry><material name="black"/></visual><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>

  <!-- 2. 左右平衡轮 (虚拟差速驱动，连续关节，承受车头重力) -->
  <joint name="${namespace}left_wheel_joint" type="continuous"><parent link="${namespace}body_geometry_link"/><child link="${namespace}left_wheel_link"/><origin xyz="1.020 0.279 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="${namespace}left_wheel_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.045" radius="0.05"/></geometry><material name="grey"/></visual><collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.045" radius="0.05"/></geometry></collision><inertial><mass value="2"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>

  <joint name="${namespace}right_wheel_joint" type="continuous"><parent link="${namespace}body_geometry_link"/><child link="${namespace}right_wheel_link"/><origin xyz="1.020 -0.279 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="${namespace}right_wheel_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.045" radius="0.05"/></geometry><material name="grey"/></visual><collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.045" radius="0.05"/></geometry></collision><inertial><mass value="2"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>

  <!-- 3. 后部 4个承重轮 (固定滑动) -->
  <joint name="${namespace}load_wheel_fl_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}load_wheel_fl_link"/><origin xyz="0.05 0.21 0.04" rpy="0 0 0"/></joint>
  <link name="${namespace}load_wheel_fl_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry><material name="dark"/></visual><collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry></collision><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <gazebo reference="${namespace}load_wheel_fl_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <joint name="${namespace}load_wheel_rl_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}load_wheel_rl_link"/><origin xyz="-0.05 0.21 0.04" rpy="0 0 0"/></joint>
  <link name="${namespace}load_wheel_rl_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry><material name="dark"/></visual><collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry></collision><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <gazebo reference="${namespace}load_wheel_rl_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <joint name="${namespace}load_wheel_fr_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}load_wheel_fr_link"/><origin xyz="0.05 -0.21 0.04" rpy="0 0 0"/></joint>
  <link name="${namespace}load_wheel_fr_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry><material name="dark"/></visual><collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry></collision><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <gazebo reference="${namespace}load_wheel_fr_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <joint name="${namespace}load_wheel_rr_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}load_wheel_rr_link"/><origin xyz="-0.05 -0.21 0.04" rpy="0 0 0"/></joint>
  <link name="${namespace}load_wheel_rr_link"><visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry><material name="dark"/></visual><collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.07" radius="0.04"/></geometry></collision><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <gazebo reference="${namespace}load_wheel_rr_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <!-- ================= 传感器位置 ================= -->
  <joint name="${namespace}imu_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}imu_link"/><origin xyz="1.020 0.093 1.185" rpy="0 0 3.141592653589793"/></joint>
  <link name="${namespace}imu_link"/>

  <joint name="${namespace}top_lidar_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}top_lidar_link"/><origin xyz="1.020 0 2.20" rpy="0 0 3.141592653589793"/></joint>
  <link name="${namespace}top_lidar_link"><visual><geometry><cylinder length="0.05" radius="0.08"/></geometry><material name="blue"/></visual></link>
  <joint name="${namespace}safety_lidar_joint" type="fixed">
    <parent link="${namespace}body_geometry_link"/>
    <child link="${namespace}safety_lidar_link"/>
    <origin xyz="0.68 0 0.30" rpy="0 0 3.141592653589793"/>
  </joint>
  <link name="${namespace}safety_lidar_link">
    <visual><geometry><box size="0.04 0.08 0.04"/></geometry><material name="red"/></visual>
  </link>
  <xacro:if value="$(arg mapping_lidar)">
    <!-- Survey-only sensor ahead of the forks: clear 360-degree sight at a
         height that intersects buffer fences, pallets and lower rack beams. -->
    <joint name="${namespace}mapping_lidar_joint" type="fixed">
      <parent link="${namespace}base_footprint"/>
      <child link="${namespace}mapping_lidar_link"/>
      <origin xyz="-1.80 0 0.72" rpy="0 0 3.141592653589793"/>
    </joint>
    <link name="${namespace}mapping_lidar_link"/>
  </xacro:if>

  <joint name="${namespace}left_bumper_lidar_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}left_bumper_lidar_link"/><origin xyz="1.127 0.374 0.1" rpy="0 0 0.7854"/></joint>
  <link name="${namespace}left_bumper_lidar_link"><visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual></link>

  <joint name="${namespace}right_bumper_lidar_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}right_bumper_lidar_link"/><origin xyz="1.127 -0.374 0.1" rpy="0 0 -0.7854"/></joint>
  <link name="${namespace}right_bumper_lidar_link"><visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual></link>

  <joint name="${namespace}rear_bumper_lidar_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}rear_bumper_lidar_link"/><origin xyz="0.775 0 0.1" rpy="0 0 -3.1416"/></joint>
  <link name="${namespace}rear_bumper_lidar_link"><visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual></link>

  <joint name="${namespace}top_3d_lidar_joint" type="fixed"><parent link="${namespace}body_geometry_link"/><child link="${namespace}top_3d_lidar_link"/><origin xyz="1.057 0 1.935" rpy="0 0 3.141592653589793"/></joint>
  <link name="${namespace}top_3d_lidar_link"><visual><geometry><cylinder length="0.04" radius="0.06"/></geometry><material name="green"/></visual></link>

  <!-- ================= Gazebo 插件与传感器系统 ================= -->
  <gazebo>
    <plugin filename="libwarehouse_command_watchdog.so" name="warehouse::CommandWatchdog">
      <input_topic>/${robot_id}/cmd_vel</input_topic>
      <output_topic>/${robot_id}/drive_cmd_vel</output_topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>${namespace}fork_elevator_joint</joint_name>
      <topic>/${robot_id}/fork_position</topic>
      <p_gain>6000</p_gain><i_gain>0</i_gain><d_gain>300</d_gain>
      <cmd_offset>294.3</cmd_offset>
      <cmd_max>10000</cmd_max><cmd_min>-10000</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>${namespace}left_wheel_joint</left_joint>
      <right_joint>${namespace}right_wheel_joint</right_joint>
      <wheel_separation>0.558</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>$(arg odom_rate)</odom_publish_frequency>
      <topic>/${robot_id}/drive_cmd_vel</topic>
      <odom_topic>/${robot_id}/odom</odom_topic>
      <frame_id>${namespace}odom</frame_id>
      <child_frame_id>${namespace}base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.8</max_linear_velocity>
      <min_linear_velocity>-1.8</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>${namespace}left_wheel_joint</joint_name>
      <joint_name>${namespace}right_wheel_joint</joint_name>
      <joint_name>${namespace}fork_elevator_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ================= Gazebo 传感器本体配置 ================= -->
  <gazebo reference="${namespace}imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on><update_rate>50</update_rate><visualize>false</visualize><topic>/${robot_id}/imu</topic><gz_frame_id>${namespace}imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="${namespace}top_lidar_link">
    <sensor name="nav_lidar" type="gpu_lidar">
      <always_on>true</always_on><update_rate>$(arg lidar_rate)</update_rate><visualize>false</visualize><topic>/${robot_id}/scan</topic><gz_frame_id>${namespace}top_lidar_link</gz_frame_id>
      <lidar><scan><horizontal><samples>$(arg lidar_samples)</samples><resolution>1.0</resolution><min_angle>-3.1415926</min_angle><max_angle>3.1415926</max_angle></horizontal></scan><range><min>0.15</min><max>30.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise></lidar>
    </sensor>
  </gazebo>

  <gazebo reference="${namespace}safety_lidar_link">
    <sensor name="safety_lidar" type="gpu_lidar">
      <always_on>true</always_on><update_rate>5</update_rate>
      <visualize>false</visualize><topic>/${robot_id}/scan_low</topic>
      <gz_frame_id>${namespace}safety_lidar_link</gz_frame_id>
      <lidar>
        <scan><horizontal><samples>181</samples><resolution>1</resolution>
          <min_angle>-1.5707963</min_angle><max_angle>1.5707963</max_angle>
        </horizontal></scan>
        <range><min>0.08</min><max>10</max><resolution>0.02</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
  <xacro:if value="$(arg mapping_lidar)">
  <gazebo reference="${namespace}mapping_lidar_link">
    <sensor name="survey_lidar" type="gpu_lidar">
      <always_on>true</always_on><update_rate>$(arg survey_lidar_rate)</update_rate><visualize>false</visualize>
      <topic>/${robot_id}/scan_mapping</topic><gz_frame_id>${namespace}mapping_lidar_link</gz_frame_id>
      <lidar>
        <scan><horizontal><samples>$(arg survey_lidar_samples)</samples><resolution>1</resolution>
          <min_angle>-3.1415926</min_angle><max_angle>3.1415926</max_angle>
        </horizontal></scan>
        <range><min>0.15</min><max>30.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
  </xacro:if>
  <xacro:if value="$(arg enable_rgbd)">
  <gazebo reference="${namespace}top_3d_lidar_link">
    <sensor name="pallet_recognition_camera" type="rgbd_camera">
      <always_on>false</always_on><update_rate>5</update_rate><visualize>false</visualize><topic>/${robot_id}/rgbd_camera</topic><gz_frame_id>${namespace}top_3d_lidar_link</gz_frame_id>
      <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10.0</far></clip><depth_camera><clip><near>0.1</near><far>10.0</far></clip></depth_camera><noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise></camera>
    </sensor>
  </gazebo>
  </xacro:if>
</robot>
